ACCIÓN trabajo_C ES
AMBIENTE

    nodo = REGISTRO
        tiempo: N(4);
        dist_Tierra: REAL;
        velocidad: REAL;
        energia_c: REAL;
        energia_p: REAL;
        energia_m: REAL;
        prox: PUNTERO A nodo;
    FIN REGISTRO;
    prim, p, q: PUNTERO A nodo;
    opc: 1..5;
    vel_ini: N(5,2);
    masa_nave, altura, delta_tiempo, i: ENTERO;
    acel, pasos: REAL;

    FUNCIÓN menu_principal() ES
        ESC("Menú princiapl de simulación");
        ESC("1. Cargar datos de entrada.");
        ESC("2. Mostrar las constantes del sistema de vuelo (gravedades, masa, distancia y posición).");
        ESC("3. Ejecutar simulación.");
        ESC("4. Ver resultados.");
        ESC("5. Salir.");
        LEER(opc);
    FIN FUNCIÓN;

    FUNCIÓN cargar_datos() ES
        ESC("Vamos a ingresar los datos de entrada para la simulación.");
        vel_ini := 0;
        MIENTRAS (vel_ini < 10500) O (vel_ini > 11500) HACER
            ESC("Ingrese la velocidad inicial (m/s en formato entero,dd - 10500..11500 recomendado): ");
            LEER(vel_ini);
            SEGÚN (vel_ini) HACER
                < 0: ESC("Error. Velocidad inicial no debe ser negativa.");
                < 10500: ESC("La nave no alcanza la Luna.");
                > 11500: ESC("No corresponde a una TLI real.");
                otro: ESC("Velocidad inicial lista.");
            FIN SEGÚN;
        FIN MIENTRAS;
        masa_nave := 0;
        MIENTRAS (masa_nave < 5000) O (masa_nave > 50000) ENTONCES
            ESC("Ingrese la masa de la nave (kg en formato entero): ");
            LEER(masa_nave);
            SEGÚN (masa_nave) HACER
                < 0: ESC("Error. Masa de nave no debe ser negativa.");
                < 5000: ESC("Debe ser una nave, no una cápsula.");
                > 50000: ESC("Nave demasiada pesada.");
                otro: ESC("Masa de la nave lista.");
            FIN SEGÚN;
        FIN MIENTRAS;
        altura := 0;
        MIENTRAS (altura < 180) O (altura > 1000) ENTONCES
            ESC("Ingrese la altura de órbita baja (km en formato entero): ");
            LEER(altura);
            SEGÚN (altura) HACER
                < 0: ESC("Error. La altura en negativo indica salir desde el núcleo de la Tierra.");
                < 180: ESC("Error. La órbita decae rápido por arrastre atmosférico residual.");
                > 1000: ESC("Imposible. Esta altura ya es órbita media.");
                otro: ESC("Altura baja válida.");
            FIN SEGÚN;
        FIN MIENTRAS;
        delta_tiempo := 0;
        MIENTRAS (delta_tiempo < 13900) O (delta_tiempo > 40000) ENTONCES
            ESC("Ingrese el delta del tiempo (seg en formato entero): ");
            LEER(delta_tiempo);
            SEGÚN (delta_tiempo) HACER
                < 0: ESC("Error. Tiempo no es negativo.");
                < 13900: ESC("Implicaría realizar 25 datos de muestra y puede ralentizarse.");
                > 30000: ESC("Pocos datos de muestra.");
                otro: ESC("Tiempo delta listo.");
            FIN SEGÚN;
            pasos := delta_tiempo DIV D;
        FIN MIENTRAS;
    FIN FUNCIÓN;
   
    GT = 9.80;
    GU = 6.674 x (10 ** -11); // N.m²/kg²   --  es la que se utiliza con las masas
    MT = 5.972 * 10 ** 24;
    ML = 7.35 * 10 ** 22;
    D = 384000;
    L1 = 326030000;
    RT = 6371;

    PROCEDIMIENTO mostrar_constantes() ES

        ESC("CONSTANTES DEL SISTEMA ARTEMIS");

        ESC("Radio de la Tierra: ", RT, " km");

        ESC("Gravedad terrestre: ", GT, " m/s²");

        ESC("Gravedad universal: ", "GU, " m/s²");

        ESC("Masa de la Tierra: ", MT, " kg");

        ESC("Masa de la Luna: ", ML, " kg");

        ESC("Distancia Tierra-Luna: ", D, " km");

        ESC("Posicion aproximada de L1 desde la Tierra: ", L1 / 1000, " km");
    FIN PROCEDIMIENTO;
    
    FUNCIÓN guardar_historia(tiempo_actual: ENTERO; dist_km: ENTERO; vel_actual: N(5,2)) ES
        // guardando en una lista simple enlazada de forma encolada
        NUEVO(p);
        *p.dist_tierra := R;
        calcular_aceleracion();
        *p.velocidad := vel_actual + acel * tiempo_actual;
        calcular_energias();
        SI (prim = NIL) ENTONCES // única inserción
            *p.tiempo := 0 + tiempo_actual;
            prim := p;
        SINO // inserción al final
            *p.tiempo := *q.tiempo + tiempo_actual;
            *q.prox := p;
        FIN SI;
        q := p;
        *p.prox := NIL;
    FIN FUNCIÓN;
    
    FUNCIÓN mostrar_resultados() ES
        p := prim;
        SI (p = NIL) ENTONCES
            ESC("No has realizado la simulación. No hay datos para mostrar.");
        SINO
            ESC("| TIEMPO | DISTANCIA AL CENTRO DE LA TIERRA | VELOCIDAD | ENERGÍA CINÉTICA | ENERGÍA POTENCIAL | ENERGÍA MECÁNICA |");
        FIN SI;
        MIENTRAS (p <> NIL) HACER
            ESC("| ", *p.tiempo, " | ", *p.dist_tierra, " | ", *p.velocidad, " | ", *p.energia_c, " | ", *p.energia_p, " | ", *p.energia_m, " |");
            p := *p.prox;
        FIN MIENTRAS;
        ESC("Fin de los resultados.");
    FIN FUNCIÓN;

    FUNCIÓN calcular_aceleracion() ES
        SI (prim = NIL) ENTONCES
            R := RT + altura;
        SINO
            R := R + *q.velocidad * delta_tiempo;
        FIN SI;
        acel := - (GU * MT / (R ** 2)) + (GU * ML / ((D - R) ** 2));
    FIN FUNCIÓN;

    FUNCIÓN calcular_energias() ES
        // Energía cinética
        *p.energia_c := 0,5 * masa_nave * (vel_ini ** )2;
        // Energía potencial
        *p.energia_p := - (GU * MT * masa_nave / R) - (GU * ML * masa_nave / (D - R));
        // Energía mecánica
        *p.energia_m := *p.energia_c + *p.energia_p;
    FIN FUNCIÓN;

    FUNCIÓN ejecutar_simulacion() ES
        // Acá tendríamos que mostrar con ASCII las cosas de vuelo (nave, Tierra, Luna, etc.)
        PARA (i := 1 HASTA pasos) HACER
            guardar_historia(delta_tiempo, R, vel_ini);
        FIN PARA;
    FIN FUNCIÓN;

    FUNCIÓN validar_entrada() ES
        // Acá tendría que ir algo para validar entradas, pero creo que todo ya tiene
    FIN FUNCIÓN;

    PROCESO
    prim := NIL;
    opc := 0;
    MIENTRAS (opc <> 5) HACER
        menu_principal();
        SEGÚN (opc) HACER
            = 1: cargar_datos();
            = 2: mostrar_constantes();
            = 3: ejecutar_simulacion();
            = 4: mostrar_resultados();
            = 5: ESC("Muchas gracias por utilizar la simulación.");
            otro: ESC("Error, fuera de rango.");
        FIN SEGÚN;
    FIN MIENTRAS;
    ESC("Gracias por utilizar la simulación.");
FIN ACCIÓN.